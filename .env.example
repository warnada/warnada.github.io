# Salin ke .env.local (tidak di-commit). Kosongkan client id untuk memakai katalog demo saja.
VITE_JAMENDO_CLIENT_ID=
# all (bawaan): semua lisensi CC, hanya untuk penggunaan NON-komersial (tanpa iklan/langganan).
# commercial: hanya lagu tanpa klausul NC; wajib bila aplikasi dimonetisasi.
VITE_JAMENDO_LICENSE_POLICY=all
